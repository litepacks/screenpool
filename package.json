{
  "name": "screenpool",
  "version": "0.8.0",
  "description": "Lightweight in-process rendering pool for Node.js — screenshots and PDFs via a fixed Chromium worker pool",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/createScreenPoolServer.d.ts",
      "import": "./dist/http/createScreenPoolServer.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "bin": {
    "screenpool": "dist/cli.js",
    "screenpool-mcp": "dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "skill:install": "node dist/cli.js skill install",
    "skill:install:global": "node dist/cli.js skill install --global",
    "skill:install:workspace": "node dist/cli.js skill install --workspace",
    "skill:install:all": "node dist/cli.js skill install --all",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:diagnostics": "tsx scripts/benchmark-diagnostics.ts",
    "benchmark:stealth": "tsx scripts/benchmark-stealth.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@puppeteer/browsers": "^3.2.1",
    "hono": "^4.13.4",
    "mcponce": "^0.3.0",
    "pipsel": "^0.0.7",
    "puppeteer-core": "^25.8.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "unitup": "^0.1.5",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/yargs": "^17.0.35",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "puppeteer",
    "screenshot",
    "pdf",
    "chromium",
    "headless",
    "render-pool"
  ],
  "license": "MIT"
}
